{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Survalent Command Sequence",
  "scopeName": "source.survalent",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declare" },
    { "include": "#keywords-action" },
    { "include": "#operators-logical" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#variables" },
    { "include": "#timespan" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.exclamation.survalent",
          "match": "!.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.survalent",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.survalent",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.survalent",
          "match": "(?i)\\b(DO|WHILE|ENDDO|IF|THEN|ELSE|ELSEIF|ENDIF|FOR|ENDFOR|NEXT)\\b"
        }
      ]
    },
    "keywords-declare": {
      "patterns": [
        {
          "name": "storage.type.survalent",
          "match": "(?i)\\b(DEFINE|FLOAT|INTEGER|STRING)\\b"
        }
      ]
    },
    "keywords-action": {
      "patterns": [
        {
          "name": "support.function.survalent",
          "match": "(?i)\\b(STOP|START|DELAY)\\b"
        }
      ]
    },
    "operators-logical": {
      "patterns": [
        {
          "name": "keyword.operator.logical.survalent",
          "match": "(?i)\\.(AND|OR|NOT|EQ|NE|LT|LE|GT|GE)\\."
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.survalent",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.survalent",
          "match": "[+\\-*/]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.survalent",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.survalent",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "timespan": {
      "patterns": [
        {
          "name": "constant.numeric.timespan.survalent",
          "match": "\\b[0-9]+(s|ms|m|h)\\b"
        }
      ]
    }
  }
}
