! Useful Command Sequences - The point hasn't changed for 15M

DEFINE FLOAT $PREV
DEFINE FLOAT $ELAPSED
DEFINE FLOAT $CURRENT

! Initialize values
$PREV = "stationA,pointA"
$ELAPSED = 0

! Infinite loop for monitoring
DO WHILE (1)
$CURRENT = " stationA,pointA " !Point for monitoring

! If the value has not changed
IF ($CURRENT .EQ. $PREV)
! Increment the elapsed time counter
$ELAPSED = $ELAPSED + 1000
! If the time exceeds 15 minutes (900,000 ms), change a pseudo point
IF ($ELAPSED .GE. 900000)
" stationB,pointB" = 1 ! change state of a pseudo point
ENDIF
ELSE
! Reset the timer and update the previous value if the point changes
$PREV = $CURRENT
$ELAPSED = 0
ENDIF

DELAY 1000Ms ! Wait 1 second before checking again

ENDWHILE
